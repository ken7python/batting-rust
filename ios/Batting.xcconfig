ARCHS = arm64
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
CLANG_ENABLE_OBJC_ARC = YES
CODE_SIGN_STYLE = Automatic
CURRENT_PROJECT_VERSION = 12
ENABLE_USER_SCRIPT_SANDBOXING = NO
INFOPLIST_FILE = Info.plist
IPHONEOS_DEPLOYMENT_TARGET = 16.0
MARKETING_VERSION = 0.10.0
OTHER_LDFLAGS = $(inherited) "$(DERIVED_FILE_DIR)/libbatting.a" -framework AudioToolbox -framework CoreAudio -framework CoreGraphics -framework CoreVideo -framework Foundation -framework GLKit -framework ImageIO -framework Metal -framework MetalKit -framework OpenGLES -framework QuartzCore -framework Security -framework UIKit -framework Vision -lobjc
PRODUCT_BUNDLE_IDENTIFIER = com.ken7python.batting.ios
PRODUCT_NAME = Batting
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
TARGETED_DEVICE_FAMILY = 1,2
ENABLE_DEBUG_DYLIB = NO
